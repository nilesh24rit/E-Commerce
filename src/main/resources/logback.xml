<?xml version="1.0" encoding="UTF-8"?>
<configuration scan="true" scanPeriod="30 seconds">

    <property name="LOG_DIR" value="logs" />
    <property name="APP_NAME" value="commercex" />
    
    <!-- Console Appender with Color Formatting -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %highlight(%-5level) [%blue(%t)] [%yellow(%X{correlationId:-SYSTEM})] %cyan(%logger{36}) : %msg%n</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- Daily Rolling File Appender (Creates a new log file every day) -->
    <appender name="DAILY_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/${APP_NAME}.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <!-- Rollover daily and when file size exceeds 50MB -->
            <fileNamePattern>${LOG_DIR}/${APP_NAME}-%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <!-- Keep 30 days worth of history -->
            <maxHistory>30</maxHistory>
            <!-- Max file size per individual log chunk -->
            <maxFileSize>50MB</maxFileSize>
            <!-- Cap total log directory size at 3GB -->
            <totalSizeCap>3GB</totalSizeCap>
            <cleanHistoryOnStart>false</cleanHistoryOnStart>
        </rollingPolicy>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%t] [%X{correlationId:-SYSTEM}] %logger{40} : %msg%n</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- Error-Specific Rolling File Appender -->
    <appender name="ERROR_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/${APP_NAME}-error.log</file>
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>ERROR</level>
        </filter>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/${APP_NAME}-error-%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxHistory>30</maxHistory>
            <maxFileSize>20MB</maxFileSize>
            <totalSizeCap>1GB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%t] [%X{correlationId:-SYSTEM}] %logger{40} : %msg%n%throwable</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- Categorized Loggers -->
    <!-- Application level: DEBUG in dev, INFO in root -->
    <logger name="com.commercex" level="DEBUG" additivity="false">
        <appender-ref ref="CONSOLE" />
        <appender-ref ref="DAILY_FILE" />
        <appender-ref ref="ERROR_FILE" />
    </logger>

    <!-- Trace low-level details for critical security and event filters if needed -->
    <logger name="com.commercex.security.JwtAuthenticationFilter" level="TRACE" />
    <logger name="com.commercex.security.RateLimitingFilter" level="DEBUG" />
    <logger name="com.commercex.service.impl" level="DEBUG" />
    <logger name="com.commercex.event" level="INFO" />
    <logger name="com.commercex.scheduling" level="INFO" />

    <!-- Third-party frameworks -->
    <logger name="org.springframework.web" level="INFO" />
    <logger name="org.springframework.security" level="INFO" />
    <logger name="org.springframework.kafka" level="INFO" />
    <logger name="org.hibernate.SQL" level="WARN" />
    <logger name="org.apache.kafka" level="WARN" />

    <!-- Root Logger -->
    <root level="INFO">
        <appender-ref ref="CONSOLE" />
        <appender-ref ref="DAILY_FILE" />
        <appender-ref ref="ERROR_FILE" />
    </root>

</configuration>
