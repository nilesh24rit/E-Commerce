# ====================================================
# CommerceX Environment Configuration Template
# Copy to .env and fill in actual credentials for local deployment
# DO NOT COMMIT REAL CREDENTIALS TO GIT REPOSITORIES
# ====================================================

# ---- Application Settings ----
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# ---- PostgreSQL Configuration ----
POSTGRES_DB=commercex
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_password_change_me
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/commercex
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres_password_change_me

# ---- HikariCP Connection Pool ----
DB_POOL_MAX_SIZE=20
DB_POOL_MIN_IDLE=5
DB_CONNECTION_TIMEOUT_MS=30000

# ---- Redis Configuration ----
SPRING_REDIS_HOST=localhost
SPRING_REDIS_PORT=6379
SPRING_REDIS_PASSWORD=
SPRING_REDIS_TIMEOUT_MS=2000

# ---- Kafka Configuration ----
SPRING_KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CONSUMER_GROUP_ID=commercex-group
# Production Kafka (AWS MSK) - leave empty for local PLAINTEXT
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
KAFKA_SASL_MECHANISM=PLAIN
KAFKA_SASL_JAAS_CONFIG=

# ---- Mail Configuration ----
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=your_email@domain.com
SPRING_MAIL_PASSWORD=your_mail_app_password

# ---- JWT Security Credentials ----
# Generate a secure secret: openssl rand -hex 32
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=86400000

# ---- CORS Configuration ----
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# ---- Rate Limiting ----
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_LOGIN_WINDOW=60
RATE_LIMIT_REGISTER_MAX=3
RATE_LIMIT_REGISTER_WINDOW=60

# ---- Grafana Monitoring Credentials ----
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin_password_change_me

# ---- AWS Configuration (ECS Deployment) ----
# AWS_REGION=us-east-1
# AWS_ECR_REGISTRY=<account-id>.dkr.ecr.us-east-1.amazonaws.com
# MANAGEMENT_PORT=8080
# LOG_FILE_PATH=/var/log/commercex/commercex.log
